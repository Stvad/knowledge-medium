# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# scripts/publish-packages.mjs --pack output
packed
*.local
.env
.env.*
!.env.example
powersync/cli.yaml
supabase/.temp
supabase/.branches

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Netlify folder
.netlify

# Local agent state (Claude Code). .claude/skills/ and .claude/launch.json
# are shared and tracked; everything else under .claude/ is per-machine.
.claude/worktrees/
.claude/settings.local.json
.claude/cache/
.claude/scheduled_tasks.lock

# Same for Codex: agent worktrees are per-machine checkouts, never tracked.
# (Tools that stage `.codex/` wholesale would otherwise commit whole checkouts.)
.codex/worktrees/

# Generated by `kmagent types` for local extension authoring.
agent-extensions/kernel-types/

# Scratch probes next to a flat extension. The top level of agent-extensions/ is
# now collected by the root vitest run, so a leftover probe would turn every
# other agent's `pnpm run check` in this checkout red from an untracked file.
agent-extensions/*.probe.*

# MCP server caches
.playwright-mcp/

# Scratch / temp
tmp/
